# backend/api/.htaccess - Ensure Authorization headers and CORS pass to PHP across all Apache hosts

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header to PHP (fixes Apache FastCGI/CGI stripping Authorization)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_headers.c>
    # Ensure options preflight requests are recognized
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>
